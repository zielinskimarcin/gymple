# Supabase public project URL, for example:
# https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon or publishable client key. Never use a service-role key here.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat iOS public SDK key. This is safe to expose in the client.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=

# Public legal URLs shown in Settings and the paywall.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
